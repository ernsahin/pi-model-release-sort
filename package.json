{
  "name": "pi-model-release-sort",
  "version": "0.2.0",
  "description": "Sort pi's /model list by release date (newest first) and hide the models you don't use.",
  "type": "module",
  "license": "MIT",
  "author": "Eren Sahin",
  "homepage": "https://github.com/ernsahin/pi-model-release-sort#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernsahin/pi-model-release-sort.git"
  },
  "bugs": {
    "url": "https://github.com/ernsahin/pi-model-release-sort/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "models",
    "model-selector"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
